<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No <clear /> here: the GitHub Packages source is registered per machine by
       scripts/setup-github-feed.ps1, which keeps the token in the user-level
       config, and it has to stay visible to restores run from this repository. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="/home/iv/.nuget/local-feed" />
  </packageSources>
</configuration>
