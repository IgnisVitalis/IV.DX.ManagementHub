@using IV.ManagementHub.Web.Components.Custom
@using IV.ManagementHub.Web.Components.Custom.Base
@inherits ManagementHubComponentBase

<div class="navmenu">
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/app/instances" Match="NavLinkMatch.Prefix">Instances</FluentNavLink>
            @if (!string.IsNullOrEmpty(AppKey) && roots is not null)
            {
                @foreach (var root in roots)
                {
                    <DXNavMenuNode Node="root"
                                   ExpandedState="new Dictionary<Guid, bool>()"
                                   DataSetViewHrefFactory="@(viewId => $"/app/{AppKey}/dxUnitSetView/{viewId}")"
                                   @key="root.Id" />
                }
            }
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
