<div class="bottom-panel">
    <FluentTabs @bind-ActiveTabId="_activeTabId"
                Width="100%"
                Height="100%">
        <FluentTab Id="console" Label="Console log" Icon="@(new Icons.Regular.Size16.Bug())">
            <ConsoleLogPanel />
        </FluentTab>
        <FluentButton slot="end"
                      IconOnly="true"
                      Appearance="Appearance.Stealth"
                      Title="Hide panel"
                      OnClick="OnClose">
            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
        </FluentButton>
    </FluentTabs>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private string _activeTabId = "console";
}
