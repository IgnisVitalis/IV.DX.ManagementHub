@inherits LayoutComponentBase
@using IV.ManagementHub.Web.Components.Layout;
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager

<FluentDesignSystemProvider Id="app-root">
    <FluentLayout>
        <FluentHeader>
            <FluentStack Class="mh-header"
                         Orientation="Orientation.Horizontal"
                         Width="100%"
                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">IV.ManagementHub</FluentLabel>

                <FluentButton Appearance="Appearance.Stealth"
                              Title="User settings"
                              aria-label="User settings"
                              OnClick="OpenUserSettings">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" />
                </FluentButton>
            </FluentStack>
        </FluentHeader>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu AppKey="base" />
            <div class="body-content">
                <div class="content">
                    @Body
                </div>
            </div>
        </FluentStack>
    </FluentLayout>

    <FluentDialogProvider />
    <FluentMessageBarProvider />
    <FluentTooltipProvider />
</FluentDesignSystemProvider>

@code
{
    private void OpenUserSettings()
    {
        var appKey = ResolveAppKeyFromCurrentUri();
        NavigationManager.NavigateTo($"/app/{appKey}/user");
    }

    private string ResolveAppKeyFromCurrentUri()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            string.Equals(segments[0], "app", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(segments[1]))
        {
            return segments[1];
        }

        return "base";
    }
}
