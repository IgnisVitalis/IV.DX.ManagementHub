@inherits LayoutComponentBase
@using IV.ManagementHub.Web.Components.Layout;
@using IV.ManagementHub.Web.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject AppState AppState

<FluentDesignSystemProvider Id="app-root">
    <FluentLayout>
        <FluentHeader>
            <FluentStack Class="mh-header"
                         Orientation="Orientation.Horizontal"
                         Width="100%"
                         HorizontalGap="12"
                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H5"
                             Weight="FontWeight.Bold"
                             Color="Color.FillInverse">
                    IV.ManagementHub
                </FluentLabel>

                <FluentStack Orientation="Orientation.Horizontal"
                             HorizontalGap="8"
                             VerticalAlignment="VerticalAlignment.Center">
                    <InstanceSwitcher CurrentAppKey="@CurrentAppKey" />

                    <FluentButton Appearance="Appearance.Stealth"
                                  Title="Open super admin settings"
                                  aria-label="Open super admin settings"
                                  OnClick="OpenUserSettings">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.FillInverse" />
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentHeader>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu AppKey="@CurrentAppKey" />
            <div class="body-content">
                <div class="content">
                    @Body
                </div>
            </div>
        </FluentStack>
    </FluentLayout>

    <FluentDialogProvider />
    <FluentMessageBarProvider />
    <FluentTooltipProvider />
</FluentDesignSystemProvider>

@code
{
    private string CurrentAppKey => ResolveAppKeyFromCurrentUri();

    private void OpenUserSettings()
    {
        NavigationManager.NavigateTo($"/app/{AppState.DefaultAppKey}/user");
    }

    private string ResolveAppKeyFromCurrentUri()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            string.Equals(segments[0], "app", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(segments[1]))
        {
            return segments[1];
        }

        return AppState.DefaultAppKey;
    }
}
