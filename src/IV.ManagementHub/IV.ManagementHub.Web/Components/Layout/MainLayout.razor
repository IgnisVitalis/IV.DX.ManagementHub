@inherits LayoutComponentBase
@using IV.ManagementHub.Web.Components.Layout;
@using IV.ManagementHub.Web.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject AppState AppState

<FluentDesignSystemProvider Id="app-root">
    <FluentLayout>
        <FluentHeader>
            <FluentStack Orientation="Orientation.Horizontal" Width="100%" HorizontalGap="8"
                         HorizontalAlignment="HorizontalAlignment.Start" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H5" Weight="FontWeight.Bold">
                    @_headerTitle
                </FluentLabel>

                <FluentSpacer />
                <FluentIcon Value="@BottomPanelToggleIcon"
                            OnClick="ToggleBottomPanel" />
                <FluentIcon Value="@(new Icons.Regular.Size20.Settings().WithColor(Color.FillInverse))"
                            OnClick="OpenUserSettings" />
            </FluentStack>
        </FluentHeader>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <LeftPanel>
                <NavMenu AppKey="@CurrentAppKey" />
            </LeftPanel>
           
            <div class="body-content">
                <FluentSplitter Orientation="Orientation.Vertical"
                                Panel1MinSize="20%"
                                Panel2MinSize="@_bottomPanelMinSize"
                                Panel2Size="@_panel2Size"
                                Collapsed="@_isBottomPanelCollapsed"
                                BarSize="4"
                                BarHandle="false"
                                OnResized="OnSplitterResized"
                                Class="fill-parent">
                    <Panel1>
                        <div class="content">
                            @Body
                        </div>
                    </Panel1>
                    <Panel2>
                        <BottomPanel OnClose="CollapseBottomPanel" />
                    </Panel2>
                </FluentSplitter>
            </div>
        </FluentStack>
    </FluentLayout>

    <FluentDialogProvider />
    <FluentMessageBarProvider />
    <FluentTooltipProvider />
</FluentDesignSystemProvider>

@code
{
    private const string DefaultHeaderTitle = "IV.ManagementHub";
    private const string BottomPanelMinSize = "20rem";
    private string _headerTitle = DefaultHeaderTitle;

    private string _bottomPanelMinSize = NormalizeSplitterSize(BottomPanelMinSize);
    private string _panel2Size = NormalizeSplitterSize(BottomPanelMinSize);
    private string _lastExpandedPanel2Size = NormalizeSplitterSize(BottomPanelMinSize);
    private bool _isBottomPanelCollapsed = true;

    private string CurrentAppKey => ResolveAppKeyFromCurrentUri();
    private Icon BottomPanelToggleIcon
    {
        get
        {
            Icon icon = _isBottomPanelCollapsed
                ? new Icons.Regular.Size20.List()
                : new Icons.Regular.Size20.Dismiss();

            return icon.WithColor(Color.FillInverse);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _bottomPanelMinSize = NormalizeSplitterSize(BottomPanelMinSize);

        var appKey = CurrentAppKey;
        if (string.IsNullOrWhiteSpace(appKey))
        {
            _headerTitle = DefaultHeaderTitle;
            return;
        }

        var apps = await AppState.GetAppsAsync();
        var app = apps.FirstOrDefault(a =>
            string.Equals(a.Key, appKey, StringComparison.OrdinalIgnoreCase));
        _headerTitle = string.IsNullOrWhiteSpace(app?.Title) ? appKey : app.Title;
    }

    private void OnSplitterResized(SplitterResizedEventArgs e)
    {
        _panel2Size = $"{e.Panel2Size}px";
        _lastExpandedPanel2Size = _panel2Size;
    }

    private void ToggleBottomPanel()
    {
        if (_isBottomPanelCollapsed)
        {
            _panel2Size = _lastExpandedPanel2Size;
            _isBottomPanelCollapsed = false;
            return;
        }

        CollapseBottomPanel();
    }

    private void CollapseBottomPanel()
    {
        if (_isBottomPanelCollapsed)
            return;

        _lastExpandedPanel2Size = _panel2Size;
        _isBottomPanelCollapsed = true;
    }

    private void OpenUserSettings()
    {
        var appKey = CurrentAppKey;
        if (!string.IsNullOrWhiteSpace(appKey))
            NavigationManager.NavigateTo($"/app/{appKey}/user");
    }

    private static readonly HashSet<string> _reservedSegments = new(StringComparer.OrdinalIgnoreCase)
    {
        "instances", "dxUnitSetView", "user", "dashboard", "settings"
    };

    private string ResolveAppKeyFromCurrentUri()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            string.Equals(segments[0], "app", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(segments[1]) &&
            !_reservedSegments.Contains(segments[1]))
        {
            return segments[1];
        }

        return string.Empty;
    }

    private static string NormalizeSplitterSize(string? value)
    {
        if (TryConvertToPixels(value, out var pixels))
        {
            return $"{pixels}px";
        }

        return value ?? string.Empty;
    }

    private static bool TryConvertToPixels(string? value, out int pixels)
    {
        pixels = 0;

        if (string.IsNullOrWhiteSpace(value))
            return false;

        var trimmed = value.Trim();
        var multiplier = 1d;

        if (trimmed.EndsWith("rem", StringComparison.OrdinalIgnoreCase) ||
            trimmed.EndsWith("em", StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed[..^3];
            multiplier = 16d;
        }
        else if (trimmed.EndsWith("px", StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed[..^2];
        }
        else
        {
            return false;
        }

        if (!double.TryParse(trimmed, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var numericValue))
            return false;

        pixels = (int)Math.Ceiling(numericValue * multiplier);
        return true;
    }
}
