@inherits LayoutComponentBase
@using IV.DataProvider.WebApp.Services.Web.Contracts;
@using IV.ManagementHub.Web.ApiClients
@using IV.ManagementHub.Web.Components.Layout;
@using IV.ManagementHub.Web.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject IApiClientResolver Resolver

<FluentDesignSystemProvider Id="app-root">
    <FluentLayout>
        <FluentHeader>
            <FluentStack
                         Orientation="Orientation.Horizontal"
                         Width="100%"
                         HorizontalGap="8"
                         HorizontalAlignment="HorizontalAlignment.Start"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H5" Weight="FontWeight.Bold">
                    @_headerTitle
                </FluentLabel>

                <FluentSpacer />
                <FluentIcon Value="@(new Icons.Regular.Size20.Settings().WithColor(Color.FillInverse))" OnClick="OpenUserSettings"/>
            </FluentStack>
        </FluentHeader>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu AppKey="@CurrentAppKey" />
            <div class="body-content">
                <div class="content">
                    @Body
                </div>
            </div>
        </FluentStack>
    </FluentLayout>

    <FluentDialogProvider />
    <FluentMessageBarProvider />
    <FluentTooltipProvider />
</FluentDesignSystemProvider>

@code
{
    private const string DefaultHeaderTitle = "IV.ManagementHub";
    private readonly Dictionary<string, string> _instanceTitleCache = new(StringComparer.OrdinalIgnoreCase);
    private string? _lastResolvedAppKey;
    private string _headerTitle = DefaultHeaderTitle;

    private string CurrentAppKey => ResolveAppKeyFromCurrentUri();

    protected override async Task OnParametersSetAsync()
    {
        var appKey = CurrentAppKey;
        if (string.Equals(_lastResolvedAppKey, appKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastResolvedAppKey = appKey;
        await ResolveHeaderTitleAsync(appKey);
    }

    private void OpenUserSettings()
    {
        var appKey = string.IsNullOrWhiteSpace(CurrentAppKey) ? AppState.DefaultAppKey : CurrentAppKey;
        NavigationManager.NavigateTo($"/app/{appKey}/user");
    }

    private async Task ResolveHeaderTitleAsync(string appKey)
    {
        if (string.IsNullOrWhiteSpace(appKey))
        {
            _headerTitle = DefaultHeaderTitle;
            return;
        }

        if (_instanceTitleCache.TryGetValue(appKey, out var cachedTitle))
        {
            _headerTitle = cachedTitle;
            return;
        }

        try
        {
            var instancesApiClient = Resolver.Get<DXInstancesApiClient>(appKey);
            var instances = await instancesApiClient.GetItemsAsync();

            if (instances.Count == 0)
            {
                _instanceTitleCache[appKey] = string.Empty;
                _headerTitle = string.Empty;
                return;
            }

            var selectedInstance = instances.FirstOrDefault(instance =>
                string.Equals(instance.Key, appKey, StringComparison.OrdinalIgnoreCase));

            var resolvedTitle = string.IsNullOrWhiteSpace(selectedInstance?.Title)
                ? appKey
                : selectedInstance.Title;

            _instanceTitleCache[appKey] = resolvedTitle;
            _headerTitle = resolvedTitle;
        }
        catch
        {
            _headerTitle = appKey;
        }
    }

    private string ResolveAppKeyFromCurrentUri()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 2 &&
            string.Equals(segments[0], "app", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(segments[1]))
        {
            return segments[1];
        }

        return AppState.DefaultAppKey;
    }
}
