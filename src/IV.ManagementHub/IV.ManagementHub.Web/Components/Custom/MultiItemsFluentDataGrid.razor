@using Microsoft.FluentUI.AspNetCore.Components
@using Newtonsoft.Json.Linq
@using System.Linq
@using IV.DX.Kernel.Enums;
@using System;

@if (Definition == null)
{
    <FluentProgressRing />
}
else
{
    <FluentCard Class="unclip">
        <FluentStack Orientation="Orientation.Vertical" Width="100%">
            <FluentLabel Typo="Typography.Subject">@Definition.Name</FluentLabel>
            <FluentDivider></FluentDivider>
            <FluentCard Class="unclip">
                <FluentToolbar id="toolbar-fluent-components-two" style="width:100%">
                    <FluentButton aria-label="Add item" IconEnd="@(new Icons.Regular.Size16.AddCircle())" OnClick="Add" />
                </FluentToolbar>
                <FluentDataGrid id="defaultGrid"
                                Items="@(this.DXMultiElement.Announced.AsQueryable())"
                                TGridItem="IV.DX.Kernel.Models.DXItem"
                                RowSize="@DataGridRowSize.Medium">
                    @foreach (var column in Definition.Columns)
                    {
                        switch (column.ColumnType)
                        {
                            // ---- BOOL ----
                            case DXColumnTypeEnum.Bool:
                                <TemplateColumn Title="@column.Name" Align="Align.Center">
                                    <FluentCheckbox @key="@context.ID" Value="@(GetBool(context.Content, column))"
                                                    ValueChanged="@(v => SetBool(context.Content, column, v))" />
                                </TemplateColumn>
                                break;

                            // ---- STRING / TEXT ----
                            case DXColumnTypeEnum.String:
                            case DXColumnTypeEnum.Text:
                                <TemplateColumn Title="@column.Name" Align="Align.Center">
                                    <FluentTextField @key="@context.ID" Value="@(GetStringN(context.Content, column) ?? string.Empty)"
                                                     ValueChanged="@(v => SetStringN(context.Content, column, v))"
                                                     Style="width:100%;" />
                                </TemplateColumn>
                                break;

                            // ---- DATETIME? ----
                            case DXColumnTypeEnum.DateTime:
                                <TemplateColumn Title="@column.Name" Align="Align.Center">
                                    <FluentDatePicker @key="@context.ID" Value="@(GetDateTime(context.Content, column))"
                                                      ValueChanged="@(v => SetDateTime(context.Content, column, v))" />
                                </TemplateColumn>
                                break;


                            // ---- INT -> либо селект по EnumValues, либо number ----
                            case DXColumnTypeEnum.Int:
                                if (column.EnumValues is { Count: > 0 })
                                {
                                    <TemplateColumn Title="@column.Name" Style="overflow:visible" Align="Align.Center">
                                        <FluentSelect @key="@context.ID"
                                                      TOption="string"
                                                      Multiple="false"
                                                      Style="overflow:visible"
                                                      Value="@(GetIntAsString(context.Content, column))"
                                                      ValueChanged="@(
                                                      EventCallback.Factory.Create<string>(
                                                          this, v => SetIntFromString(context.Content, column, v)
                                                      )                                                                                                                                                                                                                                                                                                                                                                                                                              )"
                                  @attributes="GetRequiredAttr(column)">
                                            @if (column.AllowNull)
                                            {
                                                <!-- пустая строка = null -->
                                                <FluentOption TOption="string" Value="">—</FluentOption>
                                            }

                                            @foreach (var kv in column.EnumValues)
                                            {
                                                <FluentOption TOption="string" Value="@kv.Key.ToString()">
                                                    @kv.Value
                                                </FluentOption>
                                            }
                                        </FluentSelect>
                                    </TemplateColumn>
                                }
                                else
                                {
                                    <TemplateColumn Title="@column.Name" Align="Align.Center">
                                        <FluentNumberField @key="@context.ID"
                                                           TValue="long?"
                                                           Value="@(GetLongN(context.Content, column))"
                                                           ValueChanged="@(
                                                           EventCallback.Factory.Create<long?>(this, v => SetLongN(context.Content, column, v))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                