@using Microsoft.FluentUI.AspNetCore.Components
@using System.Linq

<div class="dx-picklist-trigger-wrap">
    <FluentButton Appearance="Appearance.Outline"
                 IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                 Class="dx-picklist-trigger"
                 Style="width:100%; justify-content:space-between; text-align:left;"
                 OnClick="Open">
        @CurrentText
    </FluentButton>
</div>

@if (_isOpen)
{
    <div class="dx-picklist-backdrop" @onclick="Close">
        <div class="dx-picklist-window" @onclick:stopPropagation="true">
            <div class="dx-picklist-header">
                <FluentLabel Typo="Typography.Subject">@Title</FluentLabel>
                <FluentButton Appearance="Appearance.Stealth"
                              aria-label="Close"
                              IconStart="@(new Icons.Regular.Size20.Dismiss())"
                              OnClick="Close" />
            </div>

            <div class="dx-picklist-body">
                <FluentTextField Value="@_search"
                                 ValueChanged="@(v => _search = v)"
                                 Placeholder="Search..."
                                 Style="width:100%;" />

                <FluentCard Class="dx-picklist-list-card unclip" Style="width:100%;">
                    <div class="dx-picklist-list">
                        @if (AllowNull)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                         Class="@GetItemClass(string.Empty)"
                                         OnClick="@(() => Select(string.Empty))">
                                —
                            </FluentButton>
                        }

                        @if (FilteredOptions.Count == 0)
                        {
                            <FluentLabel Class="dx-picklist-empty">No results</FluentLabel>
                        }
                        else
                        {
                            @foreach (var opt in FilteredOptions)
                            {
                                <FluentButton Appearance="Appearance.Stealth"
                                             Class="@GetItemClass(opt.Key)"
                                             OnClick="@(() => Select(opt.Key))">
                                    @opt.Value
                                </FluentButton>
                            }
                        }
                    </div>
                </FluentCard>
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private string _search = string.Empty;

    private IReadOnlyList<KeyValuePair<string, string>> _options = Array.Empty<KeyValuePair<string, string>>();
    private IReadOnlyDictionary<string, string> _textByKey = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public string Title { get; set; } = "Select";
    [Parameter] public string Placeholder { get; set; } = "—";
    [Parameter] public bool AllowNull { get; set; }

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public IEnumerable<KeyValuePair<string, string>> Options { get; set; } = Enumerable.Empty<KeyValuePair<string, string>>();

    protected override void OnParametersSet()
    {
        _options = (Options ?? Enumerable.Empty<KeyValuePair<string, string>>()).ToList();
        _textByKey = _options
            .GroupBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToDictionary(x => x.Key, x => x.Value, StringComparer.OrdinalIgnoreCase);
    }

    private string CurrentText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Value) && _textByKey.TryGetValue(Value, out var text))
                return text;

            return Placeholder;
        }
    }

    private string GetItemClass(string key)
    {
        var isSelected = string.Equals(key, Value ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        return $"dx-picklist-item {(isSelected ? "dx-selected" : string.Empty)}";
    }

    private IReadOnlyList<KeyValuePair<string, string>> FilteredOptions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
                return _options;

            var needle = _search.Trim();
            return _options
                .Where(x => x.Value?.Contains(needle, StringComparison.OrdinalIgnoreCase) == true)
                .ToList();
        }
    }

    private void Open()
    {
        _isOpen = true;
        _search = string.Empty;
    }

    private void Close()
    {
        _isOpen = false;
        _search = string.Empty;
    }

    private async Task Select(string key)
    {
        await ValueChanged.InvokeAsync(key);
        Close();
    }
}
