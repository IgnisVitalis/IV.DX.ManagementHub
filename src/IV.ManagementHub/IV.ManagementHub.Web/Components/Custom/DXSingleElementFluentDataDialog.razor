@using IV.ManagementHub.Web.Components.Custom.Base
@using Microsoft.FluentUI.AspNetCore.Components
@using Newtonsoft.Json.Linq
@using System.Linq
@using IV.DX.Kernel.Enums;
@using System;

@if (Definition == null)
{
    <FluentProgressRing />
}
else
{
    <FluentStack Orientation="Orientation.Vertical" Width="100%" Class="stack-stretch">
@*         <FluentLabel Typo="Typography.Subject">@Definition.Name</FluentLabel>
        <FluentDivider></FluentDivider> *@
        @* <FluentCard Class="unclip"> *@
            <FluentStack Orientation="Orientation.Vertical" Width="100%">
                @foreach (var column in Definition.Columns)
                {
                    <FluentLabel>@column.Name</FluentLabel>
                    <DXItemEditor ColumnDefinition="column" DXItem="DXItem"></DXItemEditor>
                }
            </FluentStack>
        @* </FluentCard> *@
    </FluentStack>
}