@using IV.ManagementHub.Common.Models.DXUnits
@using IV.ManagementHub.Web.Models.Tree
@inject NavigationManager Nav

@if (Node.Children.Count > 0)
{
    <FluentNavGroup @bind-Expanded="IsExpanded">
        <TitleTemplate>
            <span class="dx-navgroup-title"
                  @onclick="OnGroupTitleClick"
                  @onclick:stopPropagation="true"
                  @onclick:preventDefault="true">
                @Item.Name
            </span>
        </TitleTemplate>

        <ChildContent>
            @foreach (var child in Node.Children)
            {
                <DXNavMenuNode Node="child"
                               ExpandedState="ExpandedState"
                               DataSetViewHrefFactory="DataSetViewHrefFactory"
                               @key="child.Id" />
            }
        </ChildContent>
    </FluentNavGroup>
}
else if (Item.DataSetView is Guid viewIdLeaf)
{
    <FluentNavLink Href="@DataSetViewHrefFactory(viewIdLeaf)" Match="NavLinkMatch.Prefix">
        @Item.Name
    </FluentNavLink>
}
else
{
    <FluentNavLink Disabled="true">@Item.Name</FluentNavLink>
}

@code {
    [Parameter, EditorRequired] public BiTreeNode<DXPNavigationItemUnit> Node { get; set; } = default!;
    [Parameter, EditorRequired] public IDictionary<Guid, bool> ExpandedState { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Guid, string> DataSetViewHrefFactory { get; set; } = default!;

    private DXPNavigationItemUnit Item => Node.Item;

    private bool IsExpanded
    {
        get => ExpandedState.TryGetValue(Node.Id, out var v) && v;
        set => ExpandedState[Node.Id] = value;
    }

    private void OnGroupTitleClick()
    {
        IsExpanded = true;

        if (Item.DataSetView is Guid viewId)
            Nav.NavigateTo(DataSetViewHrefFactory(viewId));
    }
}
