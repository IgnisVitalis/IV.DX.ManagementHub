@inherits ManagementHubComponentBase

@using IV.DX.Kernel.Enums;
@using IV.DX.Kernel.Models;
@using IV.ManagementHub.Web.Components.Custom
@using IV.ManagementHub.Web.Components.Custom.Base

@* <div class="dialog-backdrop" @onclick="CloseDialog"> *@
<div class="dialog-backdrop">
    <div class="dialog-window" @onclick:stopPropagation="true">
        @if (_isLoaded)
        {
            <FluentStack Orientation="Orientation.Vertical" Width="100%">

                <FluentTabs Width="100%">

                    <FluentTab Label="@this.Content.DXMainElement.Attribute.Type" Id="@this.Content.DXMainElement.Attribute.Type">
                        <FluentCard Class="unclip">
                            <DXMainElementFluentDataDialog @key="@this.Content.DXMainElement.Attribute.Type" Parent="@Content" DXMainElement="@GetDXMainElement()" Definition="@GetDXMainElementStructure()"></DXMainElementFluentDataDialog>
                        </FluentCard>
                    </FluentTab>

                    @foreach (var singleItemMandatory in this._dxUnitDefinitionStructure.SingleItemMandatory.Where(x => x.Columns.Count() > 0).ToList())
                    {
                        <FluentTab Label="@singleItemMandatory.Name" Id="@singleItemMandatory.Name">
                            <FluentCard Class="unclip">
                                <DXSingleElementFluentDataDialog @key="singleItemMandatory.Name" Parent="@Content" DXSingleElement="@GetDXSingleElement(singleItemMandatory.Name)" Definition="@GetMandatoryDXSingleElementStructure(singleItemMandatory.Name)"></DXSingleElementFluentDataDialog>
                            </FluentCard>
                        </FluentTab>
                    }
                    @foreach (var multiItemMandatory in this._dxUnitDefinitionStructure.MultiItemsMandatory.Where(x => x.Columns.Count() > 0).ToList())
                    {
                        <FluentTab Label="@multiItemMandatory.Name" Id="@multiItemMandatory.Name">
                            <FluentCard Class="unclip">
                                <DXMultiElementsFluentDataDialog @key="multiItemMandatory.Name" Parent="@Content" DXMultiElement="@GetDXMultiElement(multiItemMandatory.Name)" Definition="@GetMandatoryDXMultiElementStructure(multiItemMandatory.Name)"></DXMultiElementsFluentDataDialog>
                            </FluentCard>
                        </FluentTab>
                    }
                    @foreach (var singleItemOptional in this._dxUnitDefinitionStructure.SingleItemOptional.Where(x => x.Columns.Count() > 0).ToList())
                    {
                        <FluentTab Label="@singleItemOptional.Name" Id="@singleItemOptional.Name">
                            <FluentCard Class="unclip">
                                <DXSingleElementFluentDataDialog @key="singleItemOptional.Name" Parent="@Content" DXSingleElement="@GetDXSingleElement(singleItemOptional.Name)" Definition="@GetOptionalDXSingleElementStructure(singleItemOptional.Name)"></DXSingleElementFluentDataDialog>
                            </FluentCard>
                        </FluentTab>
                    }
                    @foreach (var multiItemOptional in this._dxUnitDefinitionStructure.MultiItemsOptional.Where(x => x.Columns.Count() > 0).ToList())
                    {
                        <FluentTab Label="@multiItemOptional.Name" Id="@multiItemOptional.Name">
                            <FluentCard Class="unclip">
                                <DXMultiElementsFluentDataDialog @key="multiItemOptional.Name" Parent="@Content" DXMultiElement="@GetDXMultiElement(multiItemOptional.Name)" Definition="@GetOptionalDXMultiElementStructure(multiItemOptional.Name)"></DXMultiElementsFluentDataDialog>
                            </FluentCard>
                        </FluentTab>
                    }
                </FluentTabs>

                <FluentDivider></FluentDivider>

                <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveAsync">Save</FluentButton>
                    <FluentButton OnClick="CancelAsync">Cancel</FluentButton>
                </FluentStack>
            </FluentStack>
        }
        else
        {
            <FluentProgressRing />
        }
    </div>
</div>



