@inherits ManagementHubComponentBase

@using IV.DX.Kernel.Enums;
@using IV.DX.Kernel.Models;
@using IV.ManagementHub.Web.Components.Custom
@using IV.ManagementHub.Web.Components.Custom.Base

@* <div class="dialog-backdrop" @onclick="CloseDialog"> *@

<div class="dialog-backdrop">
    <div class="dialog-window" @onclick:stopPropagation="true">
        @if (_isLoaded)
        {
            <div class="dialog-header">
                <div class="dialog-title">
                    @this.dxModel?.DXMainElement?.Attribute?.Type
                </div>

                <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                    OnClick="CancelAsync" />
            </div>

            <div class="dialog-body">

                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="flex: 1 1 auto; min-height: 0;">
                    @if (isAccordion)
                    {
                        <FluentAccordion ActiveId="@this.dxModel.DXMainElement.Item.ID.ToString()" Style="width:100%">
                            <FluentAccordionItem Expanded="true" Heading="@this.dxModel.DXMainElement.Attribute.Type">
                                <FluentIcon Value="@(new Icons.Regular.Size20.BuildingBank())" Color="@Color.Accent"
                                    Slot="start" />
                                <FluentCard Class="unclip">
                                    <DXMainElementFluentDataDialog @key="@this.dxModel.DXMainElement.Attribute.Type"
                                        Parent="@dxModel" DXMainElement="@GetDXMainElement()"
                                        Definition="@GetDXMainElementStructure()"></DXMainElementFluentDataDialog>
                                </FluentCard>
                            </FluentAccordionItem>

                            @foreach (var singleItemMandatory in this._dxUnitDefinitionStructure.RequiredSingleElements.Where(x
                                                => x.Columns.Count() > 0).ToList())
                            {
                                @*  if (IsDXModelContainsSingleElement(singleItemMandatory))
                            { *@
                                <FluentAccordionItem Expanded="true" Heading="@singleItemMandatory.Name">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.LineHorizontal1())" Color="@Color.Accent"
                                        Slot="start" />
                                    <FluentCard Class="unclip">
                                        <DXSingleElementFluentDataDialog @key="singleItemMandatory.Name" Parent="@dxModel"
                                            DXSingleElement="@GetDXSingleElement(singleItemMandatory.Name)"
                                            Definition="@GetMandatoryDXSingleElementStructure(singleItemMandatory.Name)">
                                        </DXSingleElementFluentDataDialog>
                                    </FluentCard>
                                </FluentAccordionItem>
                                @* }
                            else
                            {
                                <FluentLabel>need to add</FluentLabel>
                            } *@
                            }
                            @foreach (var multiItemMandatory in this._dxUnitDefinitionStructure.RequiredMultiElements.Where(x =>
                                                x.Columns.Count() > 0).ToList())
                            {
                                <FluentAccordionItem Expanded="true" Heading="@multiItemMandatory.Name">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.List())" Color="@Color.Accent" Slot="start" />
                                    <FluentCard Class="unclip">
                                        <DXMultiElementsFluentDataDialog @key="multiItemMandatory.Name" AppKey="@AppKey"
                                            Parent="@dxModel" DXMultiElement="@GetDXMultiElement(multiItemMandatory.Name)"
                                            Definition="@GetMandatoryDXMultiElementStructure(multiItemMandatory.Name)">
                                        </DXMultiElementsFluentDataDialog>
                                    </FluentCard>
                                </FluentAccordionItem>
                            }
                            @foreach (var singleItemOptional in this._dxUnitDefinitionStructure.OptionalSingleElements.Where(x
                                                => x.Columns.Count() > 0).ToList())
                            {
                                <FluentAccordionItem Heading="@singleItemOptional.Name">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.LineHorizontal1())" Color="@Color.Neutral"
                                        Slot="start" />
                                    <FluentCard Class="unclip">
                                        @if (IsDXModelContainsSingleElement(singleItemOptional))
                                        {
                                            <FluentStack Orientation="Orientation.Vertical" Gap="12px"
                                                HorizontalAlignment="HorizontalAlignment.Start">
                                                <FluentButton OnClick="@(() => DeleteSingleElement(singleItemOptional))">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                                                </FluentButton>
                                                <DXSingleElementFluentDataDialog @key="singleItemOptional.Name" Parent="@dxModel"
                                                    DXSingleElement="@GetDXSingleElement(singleItemOptional.Name)"
                                                    Definition="@GetOptionalDXSingleElementStructure(singleItemOptional.Name)">
                                                </DXSingleElementFluentDataDialog>
                                            </FluentStack>
                                        }
                                        else
                                        {
                                            <FluentButton OnClick="@(() => CreateSingleElement(singleItemOptional))">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.AddCircle())" Color="Color.Accent" />
                                            </FluentButton>
                                        }
                                    </FluentCard>
                                </FluentAccordionItem>
                            }
                            @foreach (var multiItemOptional in this._dxUnitDefinitionStructure.OptionalMultiElements.Where(x =>
                                                x.Columns.Count() > 0).ToList())
                            {
                                <FluentAccordionItem Heading="@multiItemOptional.Name">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.List())" Color="@Color.Neutral" Slot="start" />
                                    <FluentCard Class="unclip">
                                        <DXMultiElementsFluentDataDialog @key="multiItemOptional.Name" AppKey="@AppKey"
                                            Parent="@dxModel" DXMultiElement="@GetDXMultiElement(multiItemOptional.Name)"
                                            Definition="@GetOptionalDXMultiElementStructure(multiItemOptional.Name)">
                                        </DXMultiElementsFluentDataDialog>
                                    </FluentCard>
                                </FluentAccordionItem>
                            }
                        </FluentAccordion>
                    }
                    else
                    {
                        <FluentTabs Width="100%">
                            <FluentTab Label="@this.dxModel.DXMainElement.Attribute.Type"
                                Id="@this.dxModel.DXMainElement.Attribute.Type">
                                <FluentCard Class="unclip">
                                    <DXMainElementFluentDataDialog @key="@this.dxModel.DXMainElement.Attribute.Type"
                                        Parent="@dxModel" DXMainElement="@GetDXMainElement()"
                                        Definition="@GetDXMainElementStructure()"></DXMainElementFluentDataDialog>
                                </FluentCard>
                            </FluentTab>

                            @foreach (var singleItemMandatory in this._dxUnitDefinitionStructure.RequiredSingleElements.Where(x
                                                => x.Columns.Count() > 0).ToList())
                            {
                                <FluentTab Label="@singleItemMandatory.Name" Id="@singleItemMandatory.Name">
                                    <FluentCard Class="unclip">
                                        <DXSingleElementFluentDataDialog @key="singleItemMandatory.Name" Parent="@dxModel"
                                            DXSingleElement="@GetDXSingleElement(singleItemMandatory.Name)"
                                            Definition="@GetMandatoryDXSingleElementStructure(singleItemMandatory.Name)">
                                        </DXSingleElementFluentDataDialog>
                                    </FluentCard>
                                </FluentTab>
                            }
                            @foreach (var multiItemMandatory in this._dxUnitDefinitionStructure.RequiredMultiElements.Where(x =>
                                                x.Columns.Count() > 0).ToList())
                            {
                                <FluentTab Label="@multiItemMandatory.Name" Id="@multiItemMandatory.Name">
                                    <FluentCard Class="unclip">
                                        <DXMultiElementsFluentDataDialog @key="multiItemMandatory.Name" Parent="@dxModel"
                                            DXMultiElement="@GetDXMultiElement(multiItemMandatory.Name)"
                                            Definition="@GetMandatoryDXMultiElementStructure(multiItemMandatory.Name)">
                                        </DXMultiElementsFluentDataDialog>
                                    </FluentCard>
                                </FluentTab>
                            }
                            @foreach (var singleItemOptional in this._dxUnitDefinitionStructure.OptionalSingleElements.Where(x
                                                => x.Columns.Count() > 0).ToList())
                            {
                                <FluentTab Label="@singleItemOptional.Name" Id="@singleItemOptional.Name">
                                    <FluentCard Class="unclip">
                                        <DXSingleElementFluentDataDialog @key="singleItemOptional.Name" Parent="@dxModel"
                                            DXSingleElement="@GetDXSingleElement(singleItemOptional.Name)"
                                            Definition="@GetOptionalDXSingleElementStructure(singleItemOptional.Name)">
                                        </DXSingleElementFluentDataDialog>
                                    </FluentCard>
                                </FluentTab>
                            }
                            @foreach (var multiItemOptional in this._dxUnitDefinitionStructure.OptionalMultiElements.Where(x =>
                                                x.Columns.Count() > 0).ToList())
                            {
                                <FluentTab Label="@multiItemOptional.Name" Id="@multiItemOptional.Name">
                                    <FluentCard Class="unclip">
                                        <DXMultiElementsFluentDataDialog @key="multiItemOptional.Name" Parent="@dxModel"
                                            DXMultiElement="@GetDXMultiElement(multiItemOptional.Name)"
                                            Definition="@GetOptionalDXMultiElementStructure(multiItemOptional.Name)">
                                        </DXMultiElementsFluentDataDialog>
                                    </FluentCard>
                                </FluentTab>
                            }
                        </FluentTabs>
                    }

                    <FluentDivider></FluentDivider>


                </FluentStack>

            </div>

            <div class="dialog-footer">
                <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveAsync"
                        IconStart="@(new Icons.Regular.Size24.Save())">Save</FluentButton>
                    <FluentButton OnClick="CancelAsync" Appearance="Appearance.Neutral"
                        IconStart="@(new Icons.Regular.Size24.DismissSquare())">Cancel</FluentButton>
                </FluentStack>
            </div>

        }
        else
        {
            <FluentProgressRing />
        }
    </div>
</div>


@* </div> *@
