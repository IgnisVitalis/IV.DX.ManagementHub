@page "/app/{AppKey}/dxUnitSetView/{dxDataSetViewID}"

@using System.Linq
@using IV.DX.Kernel.Models;
@using IV.DataProvider.WebApp.Services.Web.ApiClients
@using IV.DataProvider.WebApp.Services.Web.Contracts
@using IV.ManagementHub.Web.Components.Custom
@using IV.ManagementHub.Web.Components.Custom.Base
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.DataGrid
@using Newtonsoft.Json.Linq
@using System.Data

@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inherits ManagementHubComponentBase

@if (_isInitialLoading)
{
    <FluentProgressRing />
}
else
{
    <div class="dx-unit-list-root">
        <FluentCard class="list-card" style="flex: 1 1 auto; min-height: 0; display: flex;">
            <div class="dx-unit-list-splitter">
                <FluentSplitter BarHandle="false"
                               Collapsed="_collapse"
                               Orientation="@orientation"
                               OnResized=OnResizedHandler
                               BarSize="6"
                               Panel1MinSize="50%"
                               Panel2MinSize="25%"
                               style="height: 100%; min-height: 0;">
                    <Panel1>
                        <div class="dx-unit-list-panel">
                            <FluentToolbar>
                                <FluentButton aria-label="Add item" IconEnd="@(new Icons.Regular.Size16.AddCircle())" OnClick="@(() => OpenEditDialog(default(Guid)))" />
                            </FluentToolbar>

                            <div class="dx-unit-list-grid-scroll">
                                <FluentDataGrid TGridItem="Newtonsoft.Json.Linq.JObject"
                                                Items="@dxQueryResult.AsQueryable()"
                                                GenerateColumns="false"
                                                RowSize="@DataGridRowSize.Large">

                                    @foreach (string column in dxQueryResult.Columns)
                                    {
                                        <PropertyColumn Title="@column" Property="@(p => dxQueryResult.GetValue(p, column))" />
                                    }

                                    <TemplateColumn Title="Actions" Align="Align.Center" Width="10rem">
                                        <ChildContent Context="item">
                                            <EntityBaseActionsFluentToolbar AppKey="@AppKey" EntityID="@dxQueryResult.GetID(item)" TypeName="@dxQueryResult.TypeName" OnDeleted="@(() => OnDeleted())" OnEdited="@(() => OpenEditDialog(dxQueryResult.GetID(item)))" />
                                        </ChildContent>
                                    </TemplateColumn>
                                </FluentDataGrid>
                            </div>
                        </div>

                    </Panel1>
                    <Panel2>
                        <FluentToolbar style="width:100%">
                            <FluentIcon Value="@(new Icons.Filled.Size16.Dismiss())" Slot="end" Color="Color.Accent" OnClick="OnClosed" />
                        </FluentToolbar>
                        @* <BlockPanel Content="@selectedBlock" AppKey="@AppKey" OnDeleted="@(() => OnDeleted())" OnEdited="@(() => OpenEditDialog(selectedBlock))"></BlockPanel> *@
                    </Panel2>
                </FluentSplitter>
            </div>
        </FluentCard>
    </div>

    @if (_showDialog)
    {
        <DXUnitDialog Type="@dxQueryResult.TypeName" ID="@selectedItemID" AppKey="@AppKey" OnClosed="CloseDialog" OnSaved="OnSaved" />
    }
}
