@page "/app/{AppKey}/instances"

@using IV.DataProvider.WebApp.Services.Web.Contracts
@using IV.ManagementHub.Web.ApiClients
@using IV.ManagementHub.Web.Components.Custom
@using IV.ManagementHub.Web.Components.Custom.Base
@using IV.ManagementHub.Web.Services
@using Microsoft.FluentUI.AspNetCore.Components.DataGrid

@inherits ManagementHubComponentBase

@inject IApiClientResolver Resolver
@inject NavigationManager NavigationManager
@inject AppAuthState AuthState

<PageTitle>Instances</PageTitle>

<DXDataSetBaseView TItem="DXInstanceDto"
                   Items="@_instances.AsQueryable()"
                   IsLoading="@_isLoading"
                   IsEmpty="@(_instances.Count == 0)"
                   Collapsed="@_collapse"
                   Orientation="@_orientation"
                   OnResized="OnResizedHandler"
                   OnRowClick="OnInstanceRowClicked"
                   RowStyle="GetInstanceRowStyle"
                   RowActionsTitle="Actions"
                   RowActionsWidth="7rem">
    <ToolbarContent>
        <FluentButton aria-label="Add instance"
                      Title="Add instance"
                      IconEnd="@(new Icons.Regular.Size16.AddCircle())"
                      Disabled="@_isBusy"
                      OnClick="StartAddInstance" />
    </ToolbarContent>
    <EmptyContent>
        <FluentLabel>No instances configured.</FluentLabel>
    </EmptyContent>
    <Columns>
        <PropertyColumn TGridItem="DXInstanceDto"
                        TProp="string"
                        Title="Title"
                        Property="@(instance => instance.Title)" />
        <PropertyColumn TGridItem="DXInstanceDto"
                        TProp="string"
                        Title="Key"
                        Property="@(instance => instance.Key)" />
        <PropertyColumn TGridItem="DXInstanceDto"
                        TProp="string"
                        Title="API URL"
                        Property="@(instance => instance.ApiUrl)" />
        <TemplateColumn TGridItem="DXInstanceDto" Title="Created (UTC)">
            <ChildContent Context="instance">
                <FluentLabel>@instance.CreatedAtUtc.UtcDateTime.ToString("u")</FluentLabel>
            </ChildContent>
        </TemplateColumn>
    </Columns>
    <RowActions Context="instance">
        <FluentButton aria-label="Select instance"
                      Title="Select instance"
                      IconEnd="@(new Icons.Regular.Size16.Checkmark())"
                      OnClick="@(() => SelectInstance(instance.Key))" />
    </RowActions>
    <DetailToolbarContent>
        <FluentStack Orientation="Orientation.Horizontal"
                     Width="100%"
                     HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentButton aria-label="Select instance"
                          Title="Select instance"
                          IconEnd="@(new Icons.Regular.Size16.Checkmark())"
                          Disabled="@(_selectedPreviewInstance is null)"
                          OnClick="SelectSelectedInstance" />

            <FluentButton aria-label="Close preview"
                          Appearance="Appearance.Stealth"
                          Disabled="@(_selectedPreviewInstance is null)"
                          OnClick="OnClosedPreview">
                <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Accent" />
            </FluentButton>
        </FluentStack>
    </DetailToolbarContent>
    <DetailContent>
        @if (_selectedPreviewInstance is null)
        {
            <FluentLabel>Select an instance row to preview details.</FluentLabel>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Width="100%" Class="stack-stretch">
                <div class="dx-viewer-field">
                    <FluentLabel Class="dx-viewer-title">Title</FluentLabel>
                    <FluentLabel Class="dx-viewer-value">@_selectedPreviewInstance.Title</FluentLabel>
                </div>

                <div class="dx-viewer-field">
                    <FluentLabel Class="dx-viewer-title">Key</FluentLabel>
                    <FluentLabel Class="dx-viewer-value">@_selectedPreviewInstance.Key</FluentLabel>
                </div>

                <div class="dx-viewer-field">
                    <FluentLabel Class="dx-viewer-title">API URL</FluentLabel>
                    <FluentLabel Class="dx-viewer-value">@_selectedPreviewInstance.ApiUrl</FluentLabel>
                </div>

                <div class="dx-viewer-field">
                    <FluentLabel Class="dx-viewer-title">Created (UTC)</FluentLabel>
                    <FluentLabel Class="dx-viewer-value">@_selectedPreviewInstance.CreatedAtUtc.UtcDateTime.ToString("u")</FluentLabel>
                </div>
            </FluentStack>
        }
    </DetailContent>
</DXDataSetBaseView>

    @if (_showAddWizard)
    {
        <div class="dx-overlay-backdrop" @onclick="CancelAddInstance">
            <div class="dx-overlay-window dx-overlay-window--md" @onclick:stopPropagation="true">
                <FluentToolbar Class="dx-overlay-header" Style="width:100%;">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 Width="100%"
                                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                 VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Subject">Add instance</FluentLabel>
                        <FluentButton Appearance="Appearance.Stealth"
                                      aria-label="Close"
                                      IconStart="@(new Icons.Regular.Size20.Dismiss())"
                                      Disabled="@_isBusy"
                                      OnClick="CancelAddInstance" />
                    </FluentStack>
                </FluentToolbar>

                <div class="dx-overlay-body">
                    <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="10">
                        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                            <FluentLabel>Title</FluentLabel>
                            <FluentTextField Value="@_newInstanceTitle"
                                             ValueChanged="@(value => _newInstanceTitle = value ?? string.Empty)"
                                             Style="width:100%;" />
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                            <FluentLabel>Key (optional)</FluentLabel>
                            <FluentTextField Value="@_newInstanceKey"
                                             ValueChanged="@(value => _newInstanceKey = value ?? string.Empty)"
                                             Style="width:100%;" />
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                            <FluentLabel>API URL</FluentLabel>
                            <FluentTextField Value="@_apiUrl"
                                             ValueChanged="@(value => _apiUrl = value ?? string.Empty)"
                                             Placeholder="https://my-dx-app.example.com"
                                             Style="width:100%;" />
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                            <FluentLabel>Service Key</FluentLabel>
                            <FluentTextField Value="@_serviceKey"
                                             ValueChanged="@(value => _serviceKey = value ?? string.Empty)"
                                             TextFieldType="TextFieldType.Password"
                                             Style="width:100%;" />
                        </FluentStack>
                    </FluentStack>
                </div>

                <FluentToolbar Class="dx-overlay-footer" Style="width:100%;">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size24.Save())"
                                      Disabled="@_isBusy"
                                      OnClick="CreateInstanceAsync">
                            @(_isBusy ? "Saving..." : "Save")
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Neutral"
                                      IconStart="@(new Icons.Regular.Size24.DismissSquare())"
                                      Disabled="@_isBusy"
                                      OnClick="CancelAddInstance">
                            Cancel
                        </FluentButton>
                    </FluentStack>
                </FluentToolbar>
            </div>
        </div>
    }

@code
{
    private DXInstancesApiClient? _instancesApiClient;
    private readonly List<DXInstanceDto> _instances = [];
    private bool _isLoading;
    private bool _isBusy;
    private bool _showAddWizard;
    private bool _collapse = true;
    private Orientation _orientation = Orientation.Horizontal;
    private DXInstanceDto? _selectedPreviewInstance;
    private string _apiUrl = string.Empty;
    private string _serviceKey = string.Empty;
    private string _newInstanceTitle = string.Empty;
    private string _newInstanceKey = string.Empty;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        _instancesApiClient = Resolver.Get<DXInstancesApiClient>(base.AppKey);
        await LoadInstancesAsync();
    }

    private async Task LoadInstancesAsync()
    {
        if (_instancesApiClient is null)
        {
            return;
        }

        _error = null;
        _isLoading = true;

        try
        {
            var instances = await _instancesApiClient.GetItemsAsync();
            _instances.Clear();
            _instances.AddRange(instances.OrderBy(instance => instance.Title, StringComparer.OrdinalIgnoreCase));

            if (_selectedPreviewInstance is not null)
            {
                var matchedInstance = _instances.FirstOrDefault(instance =>
                    string.Equals(instance.Key, _selectedPreviewInstance.Key, StringComparison.OrdinalIgnoreCase));

                if (matchedInstance is null)
                {
                    OnClosedPreview();
                }
                else
                {
                    SelectPreviewInstance(matchedInstance);
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartAddInstance()
    {
        _error = null;
        _info = null;
        _showAddWizard = true;
    }

    private void CancelAddInstance()
    {
        _showAddWizard = false;
        _error = null;
    }

    private async Task CreateInstanceAsync()
    {
        if (_instancesApiClient is null || _isBusy)
        {
            return;
        }

        _error = null;
        _info = null;

        if (string.IsNullOrWhiteSpace(_newInstanceTitle))
        {
            _error = "Instance title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_apiUrl))
        {
            _error = "API URL is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_serviceKey))
        {
            _error = "Service key is required.";
            return;
        }

        _isBusy = true;
        try
        {
            var result = await _instancesApiClient.CreateAsync(new CreateInstanceRequest(
                _newInstanceKey,
                _newInstanceTitle,
                _apiUrl,
                _serviceKey));

            if (!result.IsSuccess || result.Instance is null)
            {
                _error = result.Error ?? "Failed to create instance.";
                await LoadInstancesAsync();
                return;
            }

            _showAddWizard = false;
            _info = result.Message;
            await LoadInstancesAsync();
            SelectInstance(result.Instance.Key);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SelectInstance(string instanceKey)
    {
        if (string.IsNullOrWhiteSpace(instanceKey))
        {
            return;
        }

        var trimmedKey = instanceKey.Trim();
        AuthState.SetAppKey(trimmedKey);
        NavigationManager.NavigateTo($"/app/{trimmedKey}/instances");
    }

    private Task OnInstanceRowClicked(DXInstanceDto instance)
    {
        SelectPreviewInstance(instance);
        return Task.CompletedTask;
    }

    private string? GetInstanceRowStyle(DXInstanceDto instance)
    {
        if (_selectedPreviewInstance is null)
        {
            return null;
        }

        return string.Equals(instance.Key, _selectedPreviewInstance.Key, StringComparison.OrdinalIgnoreCase)
            ? "background-color: var(--neutral-fill-secondary-rest);"
            : null;
    }

    private void SelectPreviewInstance(DXInstanceDto instance)
    {
        _selectedPreviewInstance = instance;
        _collapse = false;
    }

    private void SelectSelectedInstance()
    {
        if (_selectedPreviewInstance is null)
        {
            return;
        }

        SelectInstance(_selectedPreviewInstance.Key);
    }

    private void OnClosedPreview()
    {
        _selectedPreviewInstance = null;
        _collapse = true;
    }

    private void OnResizedHandler(SplitterResizedEventArgs args)
    {
    }
}
