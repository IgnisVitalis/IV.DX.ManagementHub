@page "/app/{AppKey}/instance"

@using IV.DataProvider.WebApp.Services.Web.Contracts
@using IV.ManagementHub.Web.ApiClients
@using IV.ManagementHub.Web.Components.Custom.Base

@inherits ManagementHubComponentBase

@inject IApiClientResolver Resolver
@inject NavigationManager NavigationManager

<PageTitle>Instance Settings</PageTitle>

<FluentCard Class="user-settings-card">
    <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12">
        <FluentStack Orientation="Orientation.Horizontal"
                     Width="100%"
                     HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentLabel Typo="Typography.Subject">Instance Settings</FluentLabel>

            <FluentButton Appearance="Appearance.Stealth"
                          Title="Back to instances"
                          aria-label="Back to instances"
                          OnClick="GoToInstances">
                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
            </FluentButton>
        </FluentStack>

        <FluentDivider />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error">
                @_error
            </FluentMessageBar>
        }
        else if (_instance is null)
        {
            <FluentLabel>Instance not found.</FluentLabel>
        }
        else
        {
            <div class="user-settings-grid">
                <FluentLabel Color="Color.Disabled" Weight="FontWeight.Bold">Title</FluentLabel>
                <FluentLabel>@_instance.Title</FluentLabel>

                <FluentLabel Color="Color.Disabled" Weight="FontWeight.Bold">Key</FluentLabel>
                <FluentLabel>@_instance.Key</FluentLabel>

                <FluentLabel Color="Color.Disabled" Weight="FontWeight.Bold">Database Provider</FluentLabel>
                <FluentLabel>@_instance.DatabaseType</FluentLabel>

                <FluentLabel Color="Color.Disabled" Weight="FontWeight.Bold">Created (UTC)</FluentLabel>
                <FluentLabel>@_instance.CreatedAtUtc.UtcDateTime.ToString("u")</FluentLabel>
            </div>
        }
    </FluentStack>
</FluentCard>

@code
{
    private DXInstanceDto? _instance;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var instancesApiClient = Resolver.Get<DXInstancesApiClient>(base.AppKey);
            var instances = await instancesApiClient.GetItemsAsync();
            _instance = instances.FirstOrDefault(instance => string.Equals(instance.Key, base.AppKey, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void GoToInstances()
    {
        NavigationManager.NavigateTo($"/app/{base.AppKey}/instances");
    }
}
