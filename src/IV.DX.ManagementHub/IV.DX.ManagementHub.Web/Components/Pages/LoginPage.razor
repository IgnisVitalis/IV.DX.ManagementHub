@using IV.DX.Application.Contracts.Abstractions
@using IV.DX.Application.Contracts.Models
@using IV.DX.ManagementHub.Web.Services
@inject IDXSecurityService SecurityService
@inject AppAuthState AuthState
@inject NavigationManager NavigationManager

<FluentDesignSystemProvider Id="login-root">
    <div class="login-shell">
        <FluentCard Class="login-card"
                    Style="width:min(340px, calc(100vw - 2rem));max-width:340px;padding:0.9rem 0.9rem 1.1rem;height:auto !important;min-height:0 !important;display:block;align-self:center;justify-self:center;"
                    @onkeydown="OnKeyDownAsync">
            <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">IV.DX.ManagementHub</FluentLabel>

                <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                    <FluentLabel Typo="Typography.Body">Username</FluentLabel>
                    <FluentTextField Value="@_username"
                                     ValueChanged="@(value => _username = value ?? string.Empty)"
                                     Style="width:100%;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="6">
                    <FluentLabel Typo="Typography.Body">Password</FluentLabel>
                    <FluentTextField Value="@_password"
                                     ValueChanged="@(value => _password = value ?? string.Empty)"
                                     TextFieldType="TextFieldType.Password"
                                     Style="width:100%;" />
                </FluentStack>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <FluentLabel Color="Color.Error">@_error</FluentLabel>
                }

                <FluentButton Appearance="Appearance.Accent"
                              OnClick="SignInAsync"
                              Disabled="@_isSubmitting"
                              Style="width:100%;">
                    @(_isSubmitting ? "Signing in..." : "Sign in")
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </div>
</FluentDesignSystemProvider>

@code
{
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _isSubmitting;
    private string? _error;

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await SignInAsync();
        }
    }

    private async Task SignInAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _error = null;
        _isSubmitting = true;

        try
        {
            var result = await SecurityService.LoginLocalAsync(new DXLoginLocalRequest
            {
                Subject   = _username,
                Password  = _password,
                UserAgent = "ManagementHub/Blazor",
                IpAddress = "127.0.0.1",
                DeviceId  = "mh-blazor"
            });

            AuthState.SetAccessToken(result.AccessToken, _username, string.Empty);
        }
        catch (UnauthorizedAccessException)
        {
            _error = "Invalid username or password.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
