@using IV.DX.ManagementHub.Web.Components.Custom.Base
@using Microsoft.FluentUI.AspNetCore.Components
@using Newtonsoft.Json.Linq
@using System.Linq
@using IV.DX.Kernel.Enums;
@using System;

@inherits DXItemEditorBaseComponent

@code {
    [Parameter] public string? BoolLabel { get; set; }
}

@switch (ColumnDefinition.ColumnType)
{
    // ---- BOOL ----
    case DXColumnTypeEnum.Bool:
        <FluentSwitch @key="@(ColumnDefinition.Name + DXItem.ID)"
                      Label="@BoolLabel"
                      Value="@(base.GetBool(DXItem.Content, ColumnDefinition))"
                      ValueChanged="@(v => base.SetBool(DXItem.Content, ColumnDefinition, v))" />
        break;

    // ---- SENSITIVE STRING (MASKED) ----
    case DXColumnTypeEnum.HashedString:
    case DXColumnTypeEnum.EncryptedString:
        <FluentTextField @key="@(ColumnDefinition.Name + DXItem.ID)"
                         Value="@(base.GetStringN(DXItem.Content, ColumnDefinition) ?? string.Empty)"
                         ValueChanged="@(v => base.SetStringN(DXItem.Content, ColumnDefinition, v))"
                         Placeholder="******"
                         Style="width:100%;" />
        break;

    // ---- STRING / TEXT ----
    case DXColumnTypeEnum.String:
    case DXColumnTypeEnum.Text:
        <FluentTextField @key="@(ColumnDefinition.Name + DXItem.ID)"
                         Value="@(base.GetStringN(DXItem.Content, ColumnDefinition) ?? string.Empty)"
                         ValueChanged="@(v => base.SetStringN(DXItem.Content, ColumnDefinition, v))"
                         Style="width:100%;" />
        break;

    // ---- DATETIME? ----
    case DXColumnTypeEnum.DateTime:
        <FluentDatePicker @key="@(ColumnDefinition.Name + DXItem.ID)"
                          Value="@(base.GetDateTime(DXItem.Content, ColumnDefinition))"
                          ValueChanged="@(v => base.SetDateTime(DXItem.Content, ColumnDefinition, v))"
                          Style="width:100%;" />
        break;

    // ---- INT -> либо селект по EnumValues, либо number ----
    case DXColumnTypeEnum.Int:
        if (ColumnDefinition.EnumValues is { Count: > 0 })
        {
            <DXPicklistField Title="@ColumnDefinition.Name"
                             AllowNull="@ColumnDefinition.AllowNull"
                             Value="@(base.GetIntAsString(DXItem.Content, ColumnDefinition))"
                             ValueChanged="@(EventCallback.Factory.Create<string>(this, v => base.SetIntFromString(DXItem.Content, ColumnDefinition, v)))"
                             Options="@(ColumnDefinition.EnumValues.Select(kv => new KeyValuePair<string,string>(kv.Key.ToString(), kv.Value)))" />
        }
        else
        {
            <FluentNumberField @key="@(ColumnDefinition.Name + DXItem.ID)"
                               TValue="long?"
                               Value="@(base.GetLongN(DXItem.Content, ColumnDefinition))"
                               ValueChanged="@(EventCallback.Factory.Create<long?>(this, v => base.SetLongN(DXItem.Content, ColumnDefinition, v)))"
                               Style="width:100%;"
                               @attributes="base.GetRequiredAttr(ColumnDefinition)" />
        }
        break;

    // ---- SHORT/LONG -> long? ----
    case DXColumnTypeEnum.Short:
    case DXColumnTypeEnum.Long:
        <FluentNumberField @key="@(ColumnDefinition.Name + DXItem.ID)"
                           TValue="long?"
                           Value="@(base.GetLongN(DXItem.Content, ColumnDefinition))"
                           ValueChanged="@(v => base.SetLongN(DXItem.Content, ColumnDefinition, v))"
                           Placeholder=""
                           Style="width:100%;" />
        break;

    // ---- FLOAT -> double? ----
    case DXColumnTypeEnum.Float:
        <FluentNumberField @key="@(ColumnDefinition.Name + DXItem.ID)"
                           TValue="double?"
                           Value="@(base.GetDoubleN(DXItem.Content, ColumnDefinition))"
                           ValueChanged="@(v => base.SetDoubleN(DXItem.Content, ColumnDefinition, v))"
                           Placeholder=""
                           Style="width:100%;" />
        break;

    // ---- DECIMAL/CURRENCY -> decimal? ----
    case DXColumnTypeEnum.Decimal:
    case DXColumnTypeEnum.Currency:
        <FluentNumberField @key="@(ColumnDefinition.Name + DXItem.ID)"
                           TValue="decimal?"
                           Value="@(base.GetDecimalN(DXItem.Content, ColumnDefinition))"
                           ValueChanged="@(v => base.SetDecimalN(DXItem.Content, ColumnDefinition, v))"
                           Placeholder=""
                           Style="width:100%;" />
        break;

    // ---- GUID ----
    case DXColumnTypeEnum.GUID:
        if (ColumnDefinition.RelationValues is { Count: > 0 })
        {
            <DXPicklistField Title="@ColumnDefinition.Name"
                             AllowNull="@ColumnDefinition.AllowNull"
                             Value="@(base.GetGuidString(DXItem.Content, ColumnDefinition))"
                             ValueChanged="@(EventCallback.Factory.Create<string>(this, v => base.SetGuidFromString(DXItem.Content, ColumnDefinition, v)))"
                             Options="@(ColumnDefinition.RelationValues.Select(kv => new KeyValuePair<string,string>(kv.Key.ToString(), kv.Value)))" />
        }
        else
        {
            <FluentTextField @key="@(ColumnDefinition.Name + DXItem.ID)"
                             Value="@(base.GetGuidString(DXItem.Content, ColumnDefinition))"
                             ValueChanged="@(v => base.SetGuidString(DXItem.Content, ColumnDefinition, v))"
                             Style="width:100%;" />
        }
        break;

    // ---- BLOB ----
    case DXColumnTypeEnum.Blob:
        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="8">

            <FluentInputFile Id="@_blobInputId"
                             Mode="InputFileMode.Stream"
                             Multiple="false"
                             MaximumFileCount="1"
                             MaximumFileSize="@(50L * 1024 * 1024)"
                             Accept="*/*"
                             DragDropZoneVisible="true"
                             OnInputFileChange="OnBlobInputFileChange"
                             @bind-ProgressPercent="_blobProgressPercent"
                             ProgressTitle="@_blobProgressTitle"
                             Style="width:100%;">

                <ChildContent>
                    <label for="@_blobInputId" class="dx-blob-zone-click">
                        <div class="dx-blob-zone-content">
                            <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" />

                            @if (_pendingName is not null)
                            {
                                <div class="dx-blob-file">
                                    @_pendingName (@FormatSize(_pendingSize ?? 0))
                                </div>

                                <div class="dx-blob-hint">
                                    @(base.HasBlob(DXItem.Content, ColumnDefinition) ? "Replacing…" : "Uploading…")
                                </div>
                            }
                            else if (!base.HasBlob(DXItem.Content, ColumnDefinition))
                            {
                                <div class="dx-blob-main">
                                    Drag file here, or <span class="dx-blob-browse">browse</span> for it.
                                </div>
                                <div class="dx-blob-hint">One file, up to 50 MB.</div>
                            }
                            else if (base.TryGetBlobMeta(DXItem.Content, ColumnDefinition, out var name, out var mime, out var size))
                            {
                                <div class="dx-blob-file">
                                    @name (@FormatSize(size))
                                </div>
                                <div class="dx-blob-hint">Drop a new file to replace it.</div>
                            }


                            @if (_blobProgressPercent > 0)
                            {
                                @if (_blobProgressPercent > 0 && _blobProgressPercent < 100)
                                {
                                    <div class="dx-blob-progress-text">@_blobProgressPercent%</div>
                                }
                                else if (_blobProgressPercent == 100)
                                {
                                    <div class="dx-blob-progress-text">Completed</div>
                                }
                            }

                          
                        </div>
                    </label>
                </ChildContent>

            </FluentInputFile>

            @if (base.HasBlob(DXItem.Content, ColumnDefinition))
            {
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Center"
                             HorizontalGap="8"
                             Style="margin-top:8px;">

                    <a href="@GetBlobDownloadHref()"
                       download="@GetSafeDownloadName(GetBlobFileName())"
                       style="text-decoration:none;">
                        <FluentButton Appearance="Appearance.Neutral" Title="Download">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowExportUp())" Color="@Color.Info" />
                        </FluentButton>
                    </a>

                    <FluentButton Appearance="Appearance.Neutral"
                                  Title="Clear"
                                  OnClick="ClearBlobUi">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="@Color.Error" />
                    </FluentButton>
                </FluentStack>
            }
        </FluentStack>
        break;
}
