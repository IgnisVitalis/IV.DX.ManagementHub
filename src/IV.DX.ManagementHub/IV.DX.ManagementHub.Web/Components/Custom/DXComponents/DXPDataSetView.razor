@page "/app/{AppKey}/dxUnitSetView/{DXPComponentID}"
@page "/app/dxUnitSetView/{DXPComponentID}"

@using System.Linq
@using IV.DX.Kernel.Models;
@using IV.DX.Presentation.Application.Contracts.Models
@using IV.DX.Presentation.Application.Contracts.Models.Enums
@using IV.DX.ManagementHub.Web.Models
@using IV.DataProvider.WebApp.Services.Web.ApiClients
@using IV.DataProvider.WebApp.Services.Web.Contracts
@using IV.DX.ManagementHub.Web.Components.Custom
@using IV.DX.ManagementHub.Web.Components.Custom.Base
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.DataGrid
@using Newtonsoft.Json.Linq
@using System.Data

@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inherits DXPComponent<DXPDataSetViewUnit, DXPDataSetViewApiClient>

@if (IsInitialLoading)
{
    <FluentProgressRing />
}
else if (!string.IsNullOrWhiteSpace(LoadErrorMessage))
{
    <FluentMessageBar Intent="MessageIntent.Warning">
        @LoadErrorMessage
    </FluentMessageBar>
}
else
{
    <DXDataSetBaseView TItem="Newtonsoft.Json.Linq.JObject"
                       Items="@dxQueryResult.AsQueryable()"
                       Collapsed="@_collapse"
                       Orientation="@orientation"
                       OnResized="OnResizedHandler"
                       OnRowClick="OnDataRowClicked"
                       RowStyle="GetDataRowStyle"
                       EnableSelectionColumn="true"
                       SelectionHeaderCellTemplate="@SelectAllHeaderCellTemplate"
                       SelectionCellContent="@SelectRowCellTemplate"
                       RowActions="@RowActionsTemplate"
                       RowActionsAlign="Align.End"
                       RowActionsTitle="">
        <ToolbarContent>
            @if (ComponentUnit?.IsCreatable == true)
            {
                <FluentButton aria-label="Add item" Appearance="Appearance.Stealth" IconEnd="@(new Icons.Regular.Size16.AddCircle())" Disabled="@(!HasCurrentType)" OnClick="OpenCreateDialogAsync" />
            }
        </ToolbarContent>
        <Columns>
            @foreach (string column in dxQueryResult.Columns)
            {
                <PropertyColumn TGridItem="Newtonsoft.Json.Linq.JObject"
                                TProp="object"
                                Title="@column"
                                Property="@(p => dxQueryResult.GetValue(p, column))" />
            }
        </Columns>
        <DetailToolbarContent>
            <FluentStack Orientation="Orientation.Horizontal"
                         Width="100%"
                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                    @if (SelectedCount == 1 && selectedPreviewItemID is not null)
                    {
                        @foreach (var def in _customButtonDefs)
                        {
                            var capturedDef = def;
                            <FluentButton aria-label="@def.ActionDef.Name"
                                          Appearance="@DXActionButtonMapper.ToAppearance(def.Button.Style)"
                                          Title="@def.ActionDef.Description"
                                          OnClick="@(() => ExecuteCustomActionAsync(capturedDef, selectedPreviewItemID!.Value))">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" VerticalAlignment="VerticalAlignment.Center">
                                    <FluentIcon Value="@DXPActionIconHelper.GetIcon(def.Button.Icon)" Color="@DXActionButtonMapper.ToIconColor(def.Button.Color, def.Button.Style)" />
                                    <span>@def.ActionDef.Name</span>
                                </FluentStack>
                            </FluentButton>
                        }
                    }
                </FluentStack>

                <FluentButton aria-label="Close preview"
                              Appearance="Appearance.Stealth"
                              OnClick="OnClosed">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Accent" />
                </FluentButton>
            </FluentStack>
        </DetailToolbarContent>
        <DetailContent>
            <div class="dx-unit-details-content">
                @if (SelectedCount == 0)
                {
                    <FluentLabel>Select row(s) to preview data.</FluentLabel>
                }
                else if (SelectedCount == 1 && selectedPreviewItemID is not null)
                {
                    <DXUnitDetailsView AppKey="@AppKey"
                                       Type="@dxQueryResult.TypeName"
                                       ID="@selectedPreviewItemID.Value"
                                       IsEditable="@(ComponentUnit?.IsEditable == true)"
                                       IsDeletable="@(ComponentUnit?.IsDeletable == true)"
                                       IsExportable="@(ComponentUnit?.IsExportable == true)"
                                       OnChanged="OnActionChanged">
                        <AdditionalActions>
                            @foreach (var def in _customButtonDefs)
                            {
                                var capturedDef = def;
                                <FluentButton aria-label="@def.ActionDef.Name"
                                              Appearance="@DXActionButtonMapper.ToAppearance(def.Button.Style)"
                                              Title="@def.ActionDef.Description"
                                              OnClick="@(() => ExecuteCustomActionAsync(capturedDef, selectedPreviewItemID!.Value))">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" VerticalAlignment="VerticalAlignment.Center">
                                        <FluentIcon Value="@DXPActionIconHelper.GetIcon(def.Button.Icon)" Color="@DXActionButtonMapper.ToIconColor(def.Button.Color, def.Button.Style)" />
                                        <span>@def.ActionDef.Name</span>
                                    </FluentStack>
                                </FluentButton>
                            }
                        </AdditionalActions>
                    </DXUnitDetailsView>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <DXPActionButtons AppKey="@AppKey"
                                          TypeName="@dxQueryResult.TypeName"
                                          SelectedIds="@_selectedIds"
                                          IsEditable="false"
                                          IsDeletable="@(ComponentUnit?.IsDeletable == true)"
                                          IsExportable="@(ComponentUnit?.IsExportable == true)"
                                          ShowLabels="true"
                                          OnChanged="OnActionChanged" />
                        <FluentCard>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                <FluentLabel Typo="Typography.Body"><strong>Selected items</strong></FluentLabel>
                                <FluentDivider />
                                @foreach (var display in SelectedDisplayStrings)
                                {
                                    <FluentLabel>@display</FluentLabel>
                                }
                            </FluentStack>
                        </FluentCard>
                    </FluentStack>
                }
            </div>
        </DetailContent>
    </DXDataSetBaseView>

}

@code
{
    private RenderFragment<JObject>? RowActionsTemplate => HasRowActions
        ? item => @<DXPActionButtons AppKey="@AppKey"
                                      TypeName="@dxQueryResult.TypeName"
                                      SelectedIds="@(new[] { dxQueryResult.GetID(item) })"
                                      IsEditable="@(ComponentUnit?.IsEditable == true)"
                                      IsDeletable="@(ComponentUnit?.IsDeletable == true)"
                                      IsExportable="@(ComponentUnit?.IsExportable == true)"
                                      HorizontalAlignment="HorizontalAlignment.Right"
                                      OnChanged="OnActionChanged">
                      @RowCustomButtonsFor(dxQueryResult.GetID(item))
                  </DXPActionButtons>
        : null;

    private RenderFragment RowCustomButtonsFor(Guid id)
    {
        return @<text>
            @foreach (var def in _customButtonDefs)
            {
                var capturedDef = def;
                var capturedId = id;
                <FluentButton aria-label="@def.ActionDef.Name"
                              Appearance="@DXActionButtonMapper.ToAppearance(def.Button.Style)"
                              Title="@def.ActionDef.Description"
                              OnClick="@(() => ExecuteCustomActionAsync(capturedDef, capturedId))">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" VerticalAlignment="VerticalAlignment.Center">
                        <FluentIcon Value="@DXPActionIconHelper.GetIcon(def.Button.Icon)" Color="@DXActionButtonMapper.ToIconColor(def.Button.Color, def.Button.Style)" />
                        <span>@def.ActionDef.Name</span>
                    </FluentStack>
                </FluentButton>
            }
        </text>;
    }

    private RenderFragment<ColumnBase<JObject>> SelectAllHeaderCellTemplate => _ => @<div @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
        <FluentCheckbox aria-label="Select all rows"
                        Value="@IsAllRowsSelected"
                        ValueChanged="@SetSelectAllRows" />
    </div>;

    private RenderFragment<JObject> SelectRowCellTemplate => item => @<FluentCheckbox Value="@IsSelected(dxQueryResult.GetID(item))"
                                                                                       ValueChanged="@(v => SetSelected(dxQueryResult.GetID(item), v))" />;
}
