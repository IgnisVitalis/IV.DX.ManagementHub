@page "/app/{AppKey}/dxUnitCardView/{DXPComponentID}"
@page "/app/dxUnitCardView/{DXPComponentID}"

@using IV.DX.Kernel.Helpers.DXObjectHelpers
@using IV.DX.ManagementHub.Web.ApiClients
@using IV.DX.ManagementHub.Web.Components.Custom.Base
@using IV.DX.ManagementHub.Web.Components.Custom
@using IV.DX.Presentation.Application.Contracts.Models
@using Microsoft.FluentUI.AspNetCore.Components
@using Newtonsoft.Json.Linq

@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inherits DXPComponent<DXPCardViewUnit, DXCardViewApiClient>

@if (IsInitialLoading)
{
    <FluentProgressRing />
}
else if (!string.IsNullOrWhiteSpace(LoadErrorMessage))
{
    <FluentMessageBar Intent="MessageIntent.Warning">@LoadErrorMessage</FluentMessageBar>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="overflow-x: hidden; height: 100%;">

        @* toolbar *@
        <FluentStack Orientation="Orientation.Horizontal">
            @if (ComponentUnit?.IsCreatable == true)
            {
                <FluentButton aria-label="Add item" Appearance="Appearance.Stealth"
                              IconEnd="@(new Icons.Regular.Size16.AddCircle())" Disabled="@(string.IsNullOrWhiteSpace(_typeName))"
                              OnClick="OpenCreateDialog" />
            }
        </FluentStack>

        @* cards *@
        @if (_cardItems.Count == 0)
        {
            <FluentLabel>No items.</FluentLabel>
        }
        else
        {
            <FluentGrid Spacing="3" AdaptiveRendering="true" Style="width:100%; height: 100%;">
                @foreach (var item in _cardItems)
                {
                    var capturedItem = item;
                    DXObjectHelper.TryGetID(capturedItem, out var capturedItemId);
                    var title = DXObjectHelper.GetDXTitle(capturedItem)
                        ?? (capturedItemId != default ? capturedItemId.ToString() : string.Empty);

                    <FluentGridItem xs="12" sm="6" md="4">
                        <div class="@(_clickActionDef is not null ? "card-clickable" : null)"
                             @onclick="@(() => OnCardClickedAsync(capturedItemId))">
                        <FluentCard Width="100%">
                            <FluentStack Orientation="Orientation.Vertical">

                                @* actions *@
                                <div @onclick:stopPropagation style="display: contents;">
                                <DXPActionButtons AppKey="@AppKey"
                                                  TypeName="@_typeName"
                                                  SelectedIds="@(new[] { capturedItemId })"
                                                  IsEditable="@(ComponentUnit?.IsEditable == true)"
                                                  IsDeletable="@(ComponentUnit?.IsDeletable == true)"
                                                  IsExportable="@(ComponentUnit?.IsExportable == true)"
                                                  HorizontalAlignment="HorizontalAlignment.Right"
                                                  OnChanged="OnCardActionChanged" />
                                </div>

                                @* body *@
                                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                                             VerticalAlignment="VerticalAlignment.Center" Style="padding: 16px 0; flex: 1;">
                                    <FluentLabel Typo="Typography.Header" Style="text-align: center;">@title</FluentLabel>
                                </FluentStack>

                                @* bottom balance — mirrors actions row height *@
                                <div style="height: 32px;"></div>

                            </FluentStack>
                        </FluentCard>
                        </div>
                    </FluentGridItem>
                }
            </FluentGrid>
        }

    </FluentStack>
}
