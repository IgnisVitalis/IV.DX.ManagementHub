@using IV.DX.ManagementHub.Web.Models
@using IV.DX.ManagementHub.Web.Models.Tree
@inject NavigationManager Nav

@if (Node.Children.Count > 0)
{
    <FluentNavGroup @bind-Expanded="IsExpanded">
        <TitleTemplate>
            <span class="dx-navgroup-title"
                  @onclick="OnGroupTitleClick"
                  @onclick:stopPropagation="true"
                  @onclick:preventDefault="true">
                @Item.Name
            </span>
        </TitleTemplate>

        <ChildContent>
            @foreach (var child in Node.Children)
            {
                <DXNavMenuNode Node="child"
                               ExpandedState="ExpandedState"
                               ComponentHrefFactory="ComponentHrefFactory"
                               @key="child.Id" />
            }
        </ChildContent>
    </FluentNavGroup>
}
else if (ComponentHrefFactory(Item.ComponentType, Item.ComponentId) is string href)
{
    <FluentNavLink Href="@href" Match="NavLinkMatch.Prefix">
        @Item.Name
    </FluentNavLink>
}
else
{
    <FluentNavLink Disabled="true">@Item.Name</FluentNavLink>
}

@code {
    [Parameter, EditorRequired] public BiTreeNode<DXPNavItem> Node { get; set; } = default!;
    [Parameter, EditorRequired] public IDictionary<Guid, bool> ExpandedState { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Guid?, Guid?, string?> ComponentHrefFactory { get; set; } = default!;

    private DXPNavItem Item => Node.Item;

    private bool IsExpanded
    {
        get => ExpandedState.TryGetValue(Node.Id, out var v) && v;
        set => ExpandedState[Node.Id] = value;
    }

    private void OnGroupTitleClick()
    {
        IsExpanded = true;

        if (ComponentHrefFactory(Item.ComponentType, Item.ComponentId) is string href)
            Nav.NavigateTo(href);
    }
}
