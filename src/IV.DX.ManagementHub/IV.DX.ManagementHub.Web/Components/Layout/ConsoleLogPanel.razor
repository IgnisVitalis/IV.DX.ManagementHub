@using IV.DX.ManagementHub.Web.Services
@using IV.DX.ManagementHub.Web.Components.Custom
@implements IDisposable
@inject ConsoleLogService LogService

<div class="console-log">
    <FluentStack Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 Class="console-log__toolbar">
        <FluentSpacer />
        <div style="width:110px; height:28px; display:flex; align-items:stretch;">
            <DXPicklistField Title="Log Level"
                             Value="@_minLevelStr"
                             ValueChanged="OnLevelChanged"
                             Options="@_levelOptions" />
        </div>
        <FluentButton IconOnly="true"
                      Appearance="Appearance.Stealth"
                      Title="Clear"
                      Disabled="@(!HasEntries)"
                      OnClick="LogService.Clear">
            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" />
        </FluentButton>
    </FluentStack>

    <div class="console-log__content">
        @if (!HasEntries)
        {
            <FluentLabel Typo="Typography.Body" Class="console-log__empty">No entries.</FluentLabel>
        }
        else
        {
            @foreach (var entry in FilteredEntries)
            {
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Top"
                             HorizontalGap="6"
                             Class="console-entry">
                    <FluentIcon Value="@LevelIcon(entry.Level)" Color="@LevelColor(entry.Level)" Class="console-entry__icon" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="1" Class="console-entry__body">
                        <div class="console-entry__header">
                            <span class="console-entry__msg">@entry.Message</span>
                            @if (entry.Category != null)
                            {
                                <span class="console-entry__category">@entry.Category</span>
                            }
                        </div>
                        <span class="console-entry__time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                        @if (entry.StackTrace != null)
                        {
                            <details class="console-entry__details">
                                <summary class="console-entry__details-toggle">Stack trace</summary>
                                <pre class="console-entry__stacktrace">@entry.StackTrace</pre>
                            </details>
                        }
                    </FluentStack>
                </FluentStack>
            }
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<KeyValuePair<string, string>> _levelOptions =
    [
        new("Info",    "Info"),
        new("Warning", "Warning"),
        new("Error",   "Error"),
    ];

    private string _minLevelStr = "Info";

    private ConsoleLogLevel MinLevel => Enum.Parse<ConsoleLogLevel>(_minLevelStr);

    private bool HasEntries => LogService.Entries.Any();

    private IEnumerable<ConsoleLogEntry> FilteredEntries =>
        LogService.Entries.Where(e => e.Level >= MinLevel);

    protected override void OnInitialized()
    {
        LogService.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLevelChanged(string value) => _minLevelStr = value;

    public void Dispose()
    {
        LogService.Changed -= OnChanged;
    }

    private static Icon LevelIcon(ConsoleLogLevel level) => level switch
    {
        ConsoleLogLevel.Error   => new Icons.Filled.Size16.ErrorCircle(),
        ConsoleLogLevel.Warning => new Icons.Filled.Size16.Warning(),
        _                       => new Icons.Regular.Size16.Info(),
    };

    private static Color LevelColor(ConsoleLogLevel level) => level switch
    {
        ConsoleLogLevel.Error   => Color.Error,
        ConsoleLogLevel.Warning => Color.Warning,
        _                       => Color.Neutral,
    };
}
