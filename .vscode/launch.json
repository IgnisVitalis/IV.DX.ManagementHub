{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (Hot Reload)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "src/IV.DX.ManagementHub/IV.DX.ManagementHub.Web/IV.DX.ManagementHub.Web.csproj",
        "--launch-profile",
        "https"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Web (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/IV.DX.ManagementHub/IV.DX.ManagementHub.Web/bin/Debug/net9.0/IV.DX.ManagementHub.Web.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/IV.DX.ManagementHub/IV.DX.ManagementHub.Web",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7097;http://localhost:5286"
      }
    }
  ]
}
